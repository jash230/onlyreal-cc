# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/onlyreal

# Auth0 — Applications > APIs: the API "Identifier" is the audience
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.onlyreal.cc
# Optional, only for an Auth0 custom domain:
# AUTH0_ISSUER_BASE_URL=https://login.onlyreal.cc/

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional: verify Google sign-ins' age from their Google birthday (skips the date-of-birth step).
# A Machine-to-Machine app authorized for the Auth0 Management API with read:users and read:user_idp_tokens.
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=
