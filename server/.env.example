# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/onlyreal

# Clerk dashboard > Configure > API keys
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Cloudflare R2 (dashboard > R2): bucket name, public URL (r2.dev or custom domain), and an
# R2 API token with Object Read & Write on the bucket. Then: npm --prefix server run setup-storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Clerk user ids (user_...) that can delete any clip from the site, comma-separated
ADMIN_CLERK_IDS=

# Upstash Redis (console.upstash.com > database > REST API). Rate limits /api to 10 requests
# per 10s per IP; leave unset to disable rate limiting locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
