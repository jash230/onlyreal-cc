# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/onlyreal

# Clerk dashboard > Configure > API keys
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Vercel Blob (set automatically on Vercel; `vercel env pull` for local uploads)
BLOB_READ_WRITE_TOKEN=

# Clerk user ids (user_...) that can delete any clip from the site, comma-separated
ADMIN_CLERK_IDS=
