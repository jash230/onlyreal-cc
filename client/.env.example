# Auth0 — Applications > (your Single Page Application)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must equal the server's AUTH0_AUDIENCE
VITE_AUTH0_AUDIENCE=https://api.onlyreal.cc
# Ask Google for the birthday scope at sign-in (needs your own Google OAuth keys on the connection)
VITE_GOOGLE_BIRTHDAY=false
